{
  "name": "shipcheck-launch-readiness",
  "version": "0.1.0",
  "description": "Repo-local launch-readiness checks for ShipCheck.",
  "tests": [
    {
      "name": "ShipCheck scan markdown succeeds",
      "check": "output_contains",
      "params": {
        "command": "kujo run shipcheck.kujo scan --dir .",
        "expected": "# ShipCheck Release-Readiness Report"
      }
    },
    {
      "name": "ShipCheck gate JSON passes",
      "check": "command_stdout_json_path_equals",
      "params": {
        "command": "kujo run shipcheck.kujo gate --dir . --format json",
        "json_path": "summary.gate_passed",
        "expected": 1
      }
    },
    {
      "name": "ShipCheck CLI contract succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "tests/cli-output-contract.sh"
      }
    }
  ]
}
